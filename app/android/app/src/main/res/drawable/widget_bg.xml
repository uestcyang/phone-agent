<?xml version='1.0' encoding='utf-8'?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_bg_radius" />
            <gradient android:type="linear" android:angle="315" android:startColor="#FFFFFFFF" android:endColor="#FFEFF2F7" />
        </shape>
    </item>
    <item android:width="60dp" android:height="40dp" android:top="4dp" android:left="4dp" android:gravity="top|left">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="32dp" android:centerColor="#59FFFFFF" android:startColor="#59FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>